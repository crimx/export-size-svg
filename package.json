{
  "name": "export-size-svg",
  "version": "0.0.7",
  "description": "Generate SVG charts of minimized sizes for selected exports.",
  "repository": "crimx/export-size-svg",
  "main": "./lib/main.mjs",
  "module": "./lib/main.mjs",
  "types": "./lib/main.d.ts",
  "type": "module",
  "bin": "./lib/cli.mjs",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "author": {
    "name": "CRIMX",
    "email": "straybugs@gmail.com",
    "url": "https://github.com/crimx/"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "demo": "node ./lib/cli.mjs",
    "docs": "typedoc --options typedoc.json && biome format --write --config-path=biome.docs.json --files-ignore-unknown=true docs",
    "release": "commit-and-tag-version"
  },
  "keywords": [
    "export",
    "size",
    "minified",
    "minimize",
    "bundle",
    "analysis",
    "chart",
    "svg",
    "visualization",
    "bundle size",
    "export size",
    "tree-shaking",
    "module size",
    "library size",
    "javascript",
    "typescript",
    "esm",
    "code splitting",
    "optimization",
    "tooling"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.7.0",
    "@wopjs/disposable": "^0.1.19",
    "commit-and-tag-version": "^12.7.3",
    "typedoc": "^0.28.7"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "gzip-size": "^7.0.0",
    "pretty-bytes": "^7.0.0",
    "rollup": "^4.46.2",
    "sade": "^1.8.1"
  }
}
